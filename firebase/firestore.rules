rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 100
        && request.resource.data.world is int
        && request.resource.data.world >= 1
        && request.resource.data.world <= 20
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 24;
      allow update, delete: if false;
    }
  }
}
